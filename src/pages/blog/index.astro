---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogi = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---
<BaseLayout
  title="Blog o antykach — Antykopedia.pl 2026"
  description="Poradniki eksperckie o antykach: jak rozpoznać, wycenić, sprzedać, konserwować. 50+ artykułów dla kolekcjonerów, spadkobierców i hobbystów."
>
  <nav class="breadcrumbs"><a href="/">Home</a> › Blog</nav>
  <h1>Blog o antykach</h1>
  <p style="color:#666;margin:12px 0 32px;">Poradniki od ekspertów rynku antyków — jak rozpoznać oryginał, ile warte, gdzie sprzedać, jak konserwować.</p>

  <div class="grid">
    {blogi.map(b => (
      <a href={`/blog/${b.id.replace('.md','')}/`} class="card">
        {b.data.kategoria && <span class="badge">{b.data.kategoria}</span>}
        <h2>{b.data.title}</h2>
        <p class="desc">{b.data.description}</p>
        <p class="date">{new Date(b.data.pubDate).toLocaleDateString('pl-PL', {day:'numeric', month:'long', year:'numeric'})}</p>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .card {
    background: white; padding: 24px; border-radius: 12px;
    border: 1px solid #e5dcc6; text-decoration: none; color: inherit;
    transition: all .2s;
  }
  .card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(26,40,71,.1); text-decoration: none; }
  .badge {
    display: inline-block; background: #c9a961; color: #1a2847;
    padding: 3px 10px; border-radius: 20px; font-size: 11px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 10px;
  }
  .card h2 { color: #1a2847; font-size: 18px; margin: 0 0 8px; }
  .desc { color: #666; font-size: 14px; margin-bottom: 10px; }
  .date { color: #999; font-size: 12px; }
</style>
