---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
---
<BaseLayout
  title="Wyceń antyk bezpłatnie — Antykopedia.pl"
  description="Bezpłatna wycena antyków online w 24h. Meble, zegary, obrazy, srebra, numizmatyka. Prześlij zdjęcia + opis — otrzymasz wycenę + rekomendację sprzedaży."
>
  <nav class="breadcrumbs"><a href="/">Home</a> › Wyceń antyk</nav>

  <section class="hero">
    <h1>💎 Wyceń swój antyk bezpłatnie</h1>
    <p class="lead">
      Masz mebel po babci? Obraz z aukcji? Srebra z kolekcji? Prześlij zdjęcia i opis —
      nasi eksperci wycenią go <strong>w 24 godziny</strong>, bezpłatnie i bez zobowiązań.
    </p>
  </section>

  <section class="features">
    <div class="feat">
      <span class="icon">⏱️</span>
      <h3>24h odpowiedź</h3>
      <p>Otrzymasz wycenę + rekomendację najlepszego kanału sprzedaży.</p>
    </div>
    <div class="feat">
      <span class="icon">💰</span>
      <h3>Bezpłatnie</h3>
      <p>Bez zobowiązań. Nie prosimy o prowizję, nie zarabiamy na Twojej sprzedaży.</p>
    </div>
    <div class="feat">
      <span class="icon">🎓</span>
      <h3>Ekspercka wiedza</h3>
      <p>Nasi rzeczoznawcy mają doświadczenie z Desa, Agra-Art, WCN.</p>
    </div>
  </section>

  <LeadForm />

  <section class="trust">
    <h2>Jak to działa?</h2>
    <ol>
      <li><strong>Wypełnij formularz</strong> — kategoria, opis, zdjęcia (dowolna liczba)</li>
      <li><strong>Nasi eksperci analizują</strong> — autentyczność, stan, rynkowa wycena</li>
      <li><strong>Otrzymujesz odpowiedź emailem</strong> w 24h — orientacyjna wycena + plan sprzedaży</li>
      <li><strong>Decydujesz sam</strong> — kiedy, jak i gdzie sprzedać. Bez prowizji.</li>
    </ol>
  </section>
</BaseLayout>

<style>
  .hero { background: linear-gradient(135deg, #1a2847, #243b63); color: #f8f4ec; padding: 40px; border-radius: 12px; text-align: center; margin-bottom: 24px; }
  .hero h1 { color: #c9a961; font-size: 36px; margin-bottom: 12px; }
  .hero .lead { font-size: 18px; max-width: 700px; margin: 0 auto; line-height: 1.6; }
  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px; }
  .feat { background: white; padding: 24px; border-radius: 12px; border: 1px solid #e5dcc6; text-align: center; }
  .feat .icon { font-size: 36px; display: block; margin-bottom: 8px; }
  .feat h3 { color: #1a2847; margin: 0 0 8px; }
  .feat p { color: #666; font-size: 14px; }
  .trust { background: white; padding: 32px; border-radius: 12px; border: 1px solid #e5dcc6; margin-top: 32px; }
  .trust h2 { color: #1a2847; border-bottom: 2px solid #c9a961; padding-bottom: 8px; }
  .trust ol { padding-left: 24px; line-height: 1.8; }
  .trust strong { color: #1a2847; }
  @media (max-width: 640px) { .hero { padding: 24px; } .hero h1 { font-size: 26px; } .hero .lead { font-size: 15px; } }
</style>
