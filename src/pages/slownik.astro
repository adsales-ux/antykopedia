---
import BaseLayout from '../layouts/BaseLayout.astro';

const haslaRaw = [
  ['Antyk', 'Przedmiot wyprodukowany co najmniej 100 lat temu (według definicji UE). W Polsce zazwyczaj przedmioty sprzed 1920 roku.'],
  ['Art Deco', 'Styl sztuki użytkowej 1920-1940, charakteryzuje się geometrycznymi formami, egzotycznymi materiałami, luksusem.'],
  ['Art Nouveau / Secesja', 'Styl 1890-1910, organiczne krzywizny, motywy roślinne, kobiety z długimi włosami (Mucha, Wyspiański).'],
  ['Biedermeier', 'Styl mieszczański 1815-1848, meble jasne (czereśnia, brzoza), proste linie, bez zdobień barokowych.'],
  ['Chippendale', 'Styl angielski mebli XVIII w. Thomas Chippendale, charakterystyczne oparcia krzeseł "ząbkowane", mahoń.'],
  ['Dukat', 'Złota moneta XVI-XIX w., waga 3,5 g, próba 980. Dukat polski Zygmunta III wart 8-50k zł.'],
  ['EPNS', 'Electro-Plated Nickel Silver — plater srebrowy na podkładzie z stopu niklu. NIE jest srebrem antycznym.'],
  ['Fraget', 'Największa polska manufaktura srebra 1824-1944 (Warszawa). Każdy przedmiot sygnowany ma premię kolekcjonerską.'],
  ['Hallmark', 'Zestaw punc (znaków) na srebrze: próba, mistrz, miasto, rok. Pozwala zidentyfikować pochodzenie i datę.'],
  ['Impasto', 'Technika malarska polegająca na nakładaniu grubej warstwy farby. Chełmoński, Van Gogh — klasycy impasto.'],
  ['Jaskółczy ogon (dovetail)', 'Metoda łączenia desek w narożnikach szuflad. Ręczne jaskółcze ogony (XIX w.) są nieregularne; maszynowe (XX w.) idealnie równe.'],
  ['Krakelury', 'Mikropęknięcia lakieru/werniksu na obrazie olejnym. Pojawiają się po 50-100 latach. Fałszywe krakelury są "malowane" na podróbkach.'],
  ['Lustrzane bicie (proof)', 'Specjalne bicie monety dla kolekcjonerów — lustrzane tło, matowy relief. Monety proof są 30-100% droższe niż standardowe.'],
  ['Młoda Polska', 'Nurt sztuki polskiej 1890-1914. Główni artyści: Wyspiański, Malczewski, Chełmoński, Fałat. Obrazy warte 15-500k zł.'],
  ['Norblin', 'Manufaktura srebra i brązu Warszawa 1819-1944. Konkurencja Fraget. Przedmioty sygnowane "Norblin" + próba.'],
  ['Patyna', 'Naturalne ciemnienie metalu (srebro, brąz) lub lakieru (meble) wraz z upływem czasu. Patyna jest POŻĄDANA — nie usuwaj!'],
  ['Proweniencja', 'Udokumentowana historia przedmiotu (faktury, katalogi, zdjęcia). Dobra proweniencja zwiększa wartość o 20-50%.'],
  ['Próba srebra', 'Zawartość srebra w stopie: 800, 925 (sterling), 935, 958 (Britannia). Próba 925 to standard przedmiotów użytkowych.'],
  ['Punca', 'Mała wybita pieczęć na przedmiocie srebrnym/złotym. Zawiera próbę, znak mistrza, miejskiego, roku.'],
  ['Rzeczoznawca', 'Osoba uprawniona do wyceny majątku (ruchomości, nieruchomości). Dla antyków — rzeczoznawca majątkowy ds. ruchomości artystycznych.'],
  ['Stan 1 (menniczy)', 'Moneta nie była w obiegu, pełen stempel, oryginalny połysk. Najwyższa cena na rynku numizmatycznym.'],
  ['Sterling silver', 'Oznaczenie srebra próby 925 (92,5% czystego srebra). Standard używany w Wielkiej Brytanii i międzynarodowo.'],
  ['Szafowy zegar', 'Zegar stojący podłogowy (longcase), wysokość 180-240 cm, XVIII-XX w. Cena polskiego 3-25k zł, angielskiego 15-80k.'],
  ['Talar', 'Srebrna moneta XVI-XVIII w., waga 28 g. Talar Jana III Sobieskiego wart 15-80k zł w stanie 2.'],
  ['Thonet', 'Austriacka manufaktura mebli giętych 1830+. Krzesła Thonet #14 (gięte buk) są warte 300-1500 zł za sztukę.'],
  ['Werniks', 'Przezroczysty lakier chroniący powierzchnię obrazu olejnego. Z czasem żółknie — konserwator usuwa i aplikuje nowy.'],
  ['WZ', 'Punca warszawska (orzeł) używana na srebrach z Warszawy w XIX w. Oznacza polskie pochodzenie epoki zaborów.'],
  ['Zołotniki', 'Rosyjski system próby srebra do 1927 r. Próba "84 zołotnika" = 87,5% czystego srebra (zbliżona do próby 875).'],
];

const hasla = haslaRaw.sort((a, b) => a[0].localeCompare(b[0], 'pl'));
---
<BaseLayout
  title="Słownik pojęć antykwarycznych — Antykopedia.pl"
  description="Słownik antykwaryczny A-Z: style (biedermeier, art deco), techniki (impasto, krakelury), próby srebra, rodzaje monet. Niezbędnik kolekcjonera."
>
  <nav class="breadcrumbs"><a href="/">Home</a> › Słownik</nav>
  <h1>Słownik pojęć antykwarycznych</h1>
  <p style="color:#666;margin:12px 0 32px;">A-Z: style, techniki, próby, pojęcia kolekcjonerskie. Niezbędnik przy wycenie i sprzedaży antyków.</p>

  <dl class="slownik">
    {hasla.map(([haslo, def]) => (
      <>
        <dt>{haslo}</dt>
        <dd>{def}</dd>
      </>
    ))}
  </dl>
</BaseLayout>

<style>
  .slownik { background: white; padding: 32px; border-radius: 12px; border: 1px solid #e5dcc6; }
  dt { color: #1a2847; font-weight: 700; font-size: 18px; margin-top: 16px; font-family: 'Playfair Display', serif; }
  dt:first-child { margin-top: 0; }
  dd { color: #333; margin: 4px 0 0; padding-left: 0; line-height: 1.6; }
  @media (max-width: 640px) { .slownik { padding: 20px; } dt { font-size: 16px; } }
</style>
