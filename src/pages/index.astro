---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { kategorie } from '../data/kategorie.js';
import { getCollection } from 'astro:content';

const blogi = await getCollection('blog');
const latestBlogi = blogi.slice(0, 6).sort((a,b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---
<BaseLayout
  title="Antykopedia.pl — wycena, cennik i katalog antyków 2026"
  description="Portal o antykach — meble, zegary, obrazy, srebra, monety. Bezpłatna wycena online, cennik, słownik antykwariusza. Dla kolekcjonerów, spadkobierców i hobbystów."
>
  <!-- Hero -->
  <section class="hero">
    <h1>Antykopedia.pl — <span>wszystko o antykach</span></h1>
    <p class="lead">
      Portal informacyjny o <strong>antykach i staroci</strong>. Katalog 20+ kategorii, bezpłatna wycena online,
      słownik antykwariusza, poradnik dla kolekcjonerów i spadkobierców.
    </p>
    <div class="hero-stats">
      <div class="stat"><strong>20+</strong><span>kategorii antyków</span></div>
      <div class="stat"><strong>50+</strong><span>artykułów eksperckich</span></div>
      <div class="stat"><strong>24h</strong><span>czas wyceny</span></div>
    </div>
    <a href="#lead-form" class="btn-gold" style="margin-top: 20px;">💎 Wyceń swój antyk bezpłatnie →</a>
  </section>

  <!-- Kategorie -->
  <section class="section">
    <h2>Katalog kategorii</h2>
    <p>Każda kategoria to pełen przewodnik: wycena, autentyczność, konserwacja, gdzie sprzedać.</p>
    <div class="kat-grid">
      {kategorie.map(k => (
        <a href={`/kategorie/${k.slug}/`} class="kat-card">
          <span class="kat-icon">{k.icon}</span>
          <h3>{k.nazwa}</h3>
          <p class="kat-cena">{k.cena_low.toLocaleString('pl-PL')}–{k.cena_high.toLocaleString('pl-PL')} zł</p>
          <p class="kat-opis">{k.opis.slice(0, 100)}...</p>
          <span class="kat-link">Zobacz cennik →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Lead form -->
  <div id="lead-form"></div>
  <LeadForm />

  <!-- Blog -->
  <section class="section">
    <h2>Najnowsze artykuły</h2>
    <p>Poradniki eksperckie — jak rozpoznać, wycenić, sprzedać, konserwować.</p>
    <div class="blog-grid">
      {latestBlogi.map(b => (
        <a href={`/blog/${b.id.replace('.md','')}/`} class="blog-card">
          <span class="blog-kat">{b.data.kategoria || 'poradnik'}</span>
          <h3>{b.data.title}</h3>
          <p>{b.data.description}</p>
          <span class="blog-link">Czytaj →</span>
        </a>
      ))}
    </div>
    <p style="text-align:center;margin-top:24px;">
      <a href="/blog/" class="btn-gold">Zobacz wszystkie artykuły</a>
    </p>
  </section>

  <!-- Dlaczego my -->
  <section class="section why-us">
    <h2>Dlaczego Antykopedia.pl?</h2>
    <div class="why-grid">
      <div>
        <span class="why-icon">🎓</span>
        <h3>Ekspertyza</h3>
        <p>Treści tworzone przez konsultantów z 10+ latami doświadczenia na rynku antyków.</p>
      </div>
      <div>
        <span class="why-icon">💰</span>
        <h3>Bezpłatna wycena</h3>
        <p>Opisz przedmiot — otrzymasz orientacyjną wycenę w ciągu 24h bez zobowiązań.</p>
      </div>
      <div>
        <span class="why-icon">📚</span>
        <h3>Pełny katalog</h3>
        <p>20+ kategorii antyków: meble, zegary, obrazy, srebra, monety. Każdy ze cennikiem i poradnikiem.</p>
      </div>
      <div>
        <span class="why-icon">🤝</span>
        <h3>Marketplace</h3>
        <p>Już wkrótce: platforma kup/sprzedaj antyki + oferty sprawdzonych antykwariatów. (grudzień 2026)</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #1a2847 0%, #0f1a2e 100%);
    color: white;
    padding: 64px 32px;
    border-radius: 16px;
    text-align: center;
    margin-bottom: 48px;
    border: 2px solid #c9a961;
  }
  .hero h1 {
    color: white !important;
    font-size: 48px;
  }
  .hero h1 span { color: #c9a961; }
  .hero .lead {
    font-size: 18px;
    max-width: 700px;
    margin: 16px auto 24px;
    color: #ebe4d2;
  }
  .hero-stats {
    display: flex;
    gap: 48px;
    justify-content: center;
    margin: 32px 0;
    flex-wrap: wrap;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat strong {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    color: #c9a961;
  }
  .stat span { font-size: 14px; color: #ebe4d2; }

  .section {
    margin: 56px 0;
  }
  .section > p {
    color: #666;
    margin-bottom: 20px;
    font-size: 16px;
  }

  .kat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .kat-card {
    background: white;
    padding: 28px 24px;
    border-radius: 12px;
    border: 1px solid #e5dcc6;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .kat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(26,40,71,0.15);
    border-color: #c9a961;
    text-decoration: none;
  }
  .kat-icon { font-size: 42px; }
  .kat-card h3 { margin: 0; color: #1a2847; font-size: 20px; }
  .kat-cena {
    color: #a08540;
    font-weight: 700;
    font-size: 15px;
  }
  .kat-opis { color: #666; font-size: 14px; }
  .kat-link { color: #c9a961; font-weight: 600; font-size: 14px; margin-top: 8px; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .blog-card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    border: 1px solid #e5dcc6;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .blog-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26,40,71,0.1);
    text-decoration: none;
  }
  .blog-kat {
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1px;
    color: #c9a961;
    font-weight: 700;
  }
  .blog-card h3 { color: #1a2847; font-size: 17px; margin: 0; }
  .blog-card p { font-size: 14px; color: #666; }
  .blog-link { color: #a08540; font-weight: 600; font-size: 14px; }

  .why-us { background: white; padding: 48px 32px; border-radius: 16px; border: 1px solid #e5dcc6; }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    margin-top: 24px;
  }
  .why-grid > div { text-align: center; }
  .why-icon { font-size: 42px; display: block; margin-bottom: 8px; }
  .why-grid h3 { color: #1a2847; margin-bottom: 8px; }
  .why-grid p { color: #666; font-size: 14px; }

  @media (max-width: 768px) {
    .hero { padding: 40px 20px; }
    .hero h1 { font-size: 32px; }
    .hero-stats { gap: 24px; }
    .stat strong { font-size: 32px; }
  }
</style>
